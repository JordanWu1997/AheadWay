[Unit]
Description=Local owner dashboard for Orange 5 bus tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jordan/Desktop/Bus_Tracker
ExecStart=/usr/bin/python -m bus_tracker.server 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
